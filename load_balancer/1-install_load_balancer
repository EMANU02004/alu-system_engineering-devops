#!/usr/bin/env bash
# Installs and configures HAProxy to load-balance web-01 and web-02 (roundrobin)
apt-get update -y
apt-get install -y haproxy

# Enable haproxy to be started/managed via init script
if ! grep -q "ENABLED=1" /etc/default/haproxy 2>/dev/null; then
	echo "ENABLED=1" >> /etc/default/haproxy
fi

# Append frontend/backend config only if not already present (idempotent)
if ! grep -q "http_front" /etc/haproxy/haproxy.cfg; then
	cat >> /etc/haproxy/haproxy.cfg << EOF

frontend http_front
	bind *:80
	default_backend http_back

backend http_back
	balance roundrobin
	server 7034-web-01 18.233.158.107:80 check
	server 7034-web-02 44.201.84.254:80 check
EOF
fi

service haproxy restart
